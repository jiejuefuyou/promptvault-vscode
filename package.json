{
  "name": "promptvault",
  "displayName": "PromptVault — local AI prompt library",
  "description": "Pick a bundled prompt, fill typed {{variables}}, then copy, insert, or preview it. No account, telemetry, or remote prompt service.",
  "version": "1.1.0",
  "publisher": "snake-sun",
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "prompt",
    "chatgpt",
    "claude",
    "cursor",
    "midjourney",
    "template"
  ],
  "icon": "icons/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiejuefuyou/promptvault-vscode"
  },
  "homepage": "https://jiejuefuyou.github.io/prompts.html",
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCommand:promptvault.open",
    "onCommand:promptvault.insert",
    "onCommand:promptvault.preview",
    "onCommand:promptvault.reload"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "promptvault.open",
        "title": "Pick and Copy Prompt",
        "category": "PromptVault"
      },
      {
        "command": "promptvault.insert",
        "title": "Pick and Insert Prompt",
        "category": "PromptVault"
      },
      {
        "command": "promptvault.preview",
        "title": "Pick and Preview Prompt",
        "category": "PromptVault"
      },
      {
        "command": "promptvault.reload",
        "title": "Reload Bundled Prompt Library",
        "category": "PromptVault"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run verify",
    "test": "node --test tests/*.test.cjs",
    "test:extension-host": "node scripts/run-extension-host-tests.cjs",
    "lint": "node --check src/core.js && node --check src/extension.js && node scripts/verify-extension.cjs",
    "verify": "npm run lint && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0"
  }
}
